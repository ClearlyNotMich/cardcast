pkgbase = cardcast-bin
	pkgdesc = Mirror a monitor onto a capture card's display for two-PC streaming, and keep windows off it
	pkgver = 0.2.2
	pkgrel = 1
	url = https://github.com/ClearlyNotMich/cardcast
	arch = x86_64
	license = GPL-3.0-or-later
	depends = glibc
	depends = libgcc
	depends = libpipewire
	depends = pipewire
	depends = pipewire-audio
	depends = wireplumber
	depends = coreutils
	depends = vulkan-icd-loader
	depends = vulkan-driver
	depends = libxkbcommon
	depends = fontconfig
	depends = hicolor-icon-theme
	optdepends = wayland: run on a Wayland desktop
	optdepends = xdg-desktop-portal: mirror capture on Wayland, with your desktop backend (such as xdg-desktop-portal-kde)
	optdepends = libx11: run on an X11 desktop
	optdepends = libxcursor: run on an X11 desktop
	optdepends = libxi: run on an X11 desktop
	optdepends = libxkbcommon-x11: run on an X11 desktop
	provides = cardcast
	conflicts = cardcast
	options = !debug
